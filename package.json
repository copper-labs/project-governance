{
  "name": "@organta/project-governance",
  "version": "3.0.0-preview.1",
  "description": "Unified governance, durable development workflows and evidence",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "files": [
    "dist/engine",
    "dist/harness",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node components/engine/scripts/package-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test:engine": "node --test 'components/engine/test/**/*.test.ts'",
    "test:continuity": "npm --prefix components/harness test",
    "test": "npm run test:engine && npm run test:continuity && node --test 'components/engine/scripts/*.test.mjs'",
    "pack:engine": "npm run build && node components/engine/scripts/pack-engine.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "saxes": "6.0.0",
    "typescript": "5.9.3",
    "yaml": "2.9.0",
    "fast-uri": "3.1.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1"
  },
  "bin": {
    "project-governance": "dist/engine/src/cli.js"
  },
  "exports": {
    "./host/v1": {
      "types": "./dist/engine/src/host-api-v1.d.ts",
      "import": "./dist/engine/src/host-api-v1.js"
    }
  }
}
