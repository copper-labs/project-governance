{
  "name": "@organta/project-governance",
  "version": "4.7.0",
  "description": "Unified governance, durable development workflows and evidence",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "files": [
    "dist/engine",
    "dist/harness",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test:greenfield": "node components/engine/scripts/verify-greenfield.mjs",
    "build": "tsc -p tsconfig.build.json && node components/engine/scripts/package-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test:engine": "node --test --test-concurrency=2 'components/engine/test/**/*.test.ts'",
    "test:continuity": "npm --prefix components/harness test",
    "test:decision-pilot": "node --test 'components/engine/test/decision*.test.ts' components/engine/test/context-route-command.test.ts components/engine/test/context-packet.test.ts",
    "test": "npm run test:engine && npm run test:continuity && node --test 'components/engine/scripts/*.test.mjs' && node --test 'components/cowork/test/*.test.mjs'",
    "pack:engine": "npm run build && node components/engine/scripts/pack-engine.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fast-uri": "3.1.7",
    "saxes": "6.0.0",
    "typescript": "5.9.3",
    "yaml": "2.9.0",
    "@lumis-sh/wasm-dart": "0.26.6",
    "@lumis-sh/wasm-java": "0.26.3",
    "@lumis-sh/wasm-kotlin": "0.26.5",
    "@lumis-sh/wasm-objc": "0.26.2",
    "@lumis-sh/wasm-rust": "0.26.5",
    "@lumis-sh/wasm-swift": "0.26.3",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@typescript-eslint/parser": "8.46.4",
    "eslint": "9.39.1"
  },
  "bin": {
    "project-governance": "dist/engine/src/cli.js"
  },
  "exports": {
    "./evaluation/v1": {
      "types": "./dist/engine/src/evaluation-api-v1.d.ts",
      "import": "./dist/engine/src/evaluation-api-v1.js"
    },
    "./host/v1": {
      "types": "./dist/engine/src/host-api-v1.d.ts",
      "import": "./dist/engine/src/host-api-v1.js"
    }
  },
  "overrides": {
    "acorn": "8.17.0"
  }
}
