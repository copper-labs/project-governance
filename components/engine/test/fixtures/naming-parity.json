{
  "source": "Existing Python naming analyzer, 2026-09-20; output fixtures only",
  "policy": {
    "naming": {
      "forbidden_terms": [
        "legacy",
        "utils"
      ],
      "vague_terms": [
        "manager",
        "helper"
      ],
      "package_roots": [
        "packages",
        "services"
      ],
      "preferred_file_name_length": 24,
      "blocking_file_name_length": 40,
      "ignore_paths": [
        "generated/*"
      ]
    }
  },
  "cases": [
    {
      "path": "packages/voice/VoiceVoiceManager.ts",
      "isNew": true,
      "expected": [
        {
          "rule_id": "naming.adjacent-duplicate",
          "path": "packages/voice/VoiceVoiceManager.ts",
          "name": "VoiceVoiceManager",
          "severity": "blocking",
          "classification": "new-or-renamed",
          "message": "contains adjacent duplicate words"
        },
        {
          "rule_id": "naming.vague-role",
          "path": "packages/voice/VoiceVoiceManager.ts",
          "name": "VoiceVoiceManager",
          "severity": "blocking",
          "classification": "new-or-renamed",
          "message": "ends in vague role term 'manager'"
        },
        {
          "rule_id": "naming.package-repetition",
          "path": "packages/voice/VoiceVoiceManager.ts",
          "name": "VoiceVoiceManager",
          "severity": "blocking",
          "classification": "new-or-renamed",
          "message": "repeats the containing package name"
        }
      ]
    },
    {
      "path": "packages/voice/VoiceVoiceManager.ts",
      "isNew": false,
      "expected": [
        {
          "rule_id": "naming.adjacent-duplicate",
          "path": "packages/voice/VoiceVoiceManager.ts",
          "name": "VoiceVoiceManager",
          "severity": "advisory",
          "classification": "existing-debt",
          "message": "contains adjacent duplicate words"
        },
        {
          "rule_id": "naming.vague-role",
