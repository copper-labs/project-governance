          "message": "ends in vague role term 'manager'"
        },
        {
          "rule_id": "naming.package-repetition",
          "path": "packages/voice/VoiceVoiceManager.ts",
          "name": "VoiceVoiceManager",
          "severity": "advisory",
          "classification": "existing-debt",
          "message": "repeats the containing package name"
