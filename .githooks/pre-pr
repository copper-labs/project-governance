#!/usr/bin/env sh
set -eu
root="$(git rev-parse --show-toplevel)"
cd "$root"
case "$#:${1-}:${3-}" in
  0::|4:--pr-body-file:--pr-title|4:--pr-title:--pr-body-file) ;;
  *)
    echo "usage: .githooks/pre-pr [--pr-body-file <path> --pr-title <title>]" >&2
    exit 2
    ;;
esac
exec tools/run-source-governance.sh check --pack pr-description --stage pre-pr --mode impacted "$@"
