#!/bin/sh
# Validate the message through the already-installed locked runtime.
set -eu
runtime=".governance/runtime/bin/project-governance"
if [ ! -x "$runtime" ]; then
  echo "Governance runtime is unavailable. Run: python3 tools/governance-bootstrap.py" >&2
  exit 1
fi
exec "$runtime" check --stage commit-msg --mode impacted --commit-message-file "$1"
