#!/bin/sh
# Run only the already-installed locked governance runtime.
set -eu
runtime=".governance/runtime/bin/project-governance"
if [ ! -x "$runtime" ]; then
  echo "Governance runtime is unavailable. Run: python3 tools/governance-bootstrap.py" >&2
  exit 1
fi
case "$#:${1-}:${3-}" in
  0::|4:--pr-body-file:--pr-title|4:--pr-title:--pr-body-file) ;;
  *)
    echo "usage: .githooks/pre-pr [--pr-body-file <path> --pr-title <title>]" >&2
    exit 2
    ;;
esac
exec "$runtime" check --summary --pack pr-description --stage pre-pr --mode all "$@"
