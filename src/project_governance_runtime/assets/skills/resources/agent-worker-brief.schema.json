{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-governance:schema:agent-worker-brief:v1",
  "title": "Delegated worker brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "role",
    "required_capability_tier",
    "objective",
    "governing_refs",
    "base_snapshot",
    "read_scope",
    "write_scope",
    "exclusions",
    "fixed_decisions",
    "acceptance",
    "focused_proof",
    "output_token_ceiling",
    "escalate_or_stop_when"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "role": {"enum": ["research-scout", "implementation-worker", "qa-reviewer"]},
    "required_capability_tier": {"enum": ["economy", "balanced", "primary"]},
    "objective": {"type": "string", "minLength": 1},
    "governing_refs": {"$ref": "#/$defs/stringList"},
    "base_snapshot": {"type": "string", "minLength": 1, "maxLength": 256},
    "read_scope": {"$ref": "#/$defs/stringList"},
    "write_scope": {"$ref": "#/$defs/stringList"},
    "exclusions": {"$ref": "#/$defs/stringList"},
    "fixed_decisions": {"$ref": "#/$defs/stringList"},
    "acceptance": {"$ref": "#/$defs/stringList"},
    "focused_proof": {"$ref": "#/$defs/stringList"},
    "output_token_ceiling": {"type": "integer", "minimum": 1},
    "escalate_or_stop_when": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
