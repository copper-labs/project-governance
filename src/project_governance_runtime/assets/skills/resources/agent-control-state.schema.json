{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-governance:schema:agent-control-state:v1",
  "title": "Agent dispatch authorization and control state",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authorizations", "consumed_requests", "writer_lease", "suspensions"],
  "properties": {
    "version": {"const": 1},
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authorization_digest",
          "base_snapshot",
          "launch_entries",
          "delegated_token_ceiling",
          "start_expires_at",
          "lease_deadline",
          "state"
        ],
        "properties": {
          "authorization_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "base_snapshot": {"type": "string", "minLength": 1},
          "launch_entries": {"type": "array", "maxItems": 3, "items": {"type": "object"}},
          "delegated_token_ceiling": {"type": "integer", "minimum": 1},
          "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "start_expires_at": {"type": "string", "format": "date-time"},
          "lease_deadline": {"type": "string", "format": "date-time"},
          "state": {"enum": ["active", "terminal"]},
          "terminal_reason": {
            "enum": ["completed", "failed", "cancelled", "timed-out", "budget-exhausted", "needs-primary-decision"]
          },
          "terminal_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "consumed_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_digest", "start_expires_at"],
        "properties": {
          "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "start_expires_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "writer_lease": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorization_digest", "deadline"],
          "properties": {
            "authorization_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "deadline": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "suspensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "profile_id", "reason"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "profile_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
