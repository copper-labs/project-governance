{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-template.invalid/schemas/secret-waivers.schema.json",
  "title": "Embedded Secret Waivers",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "waivers"],
  "properties": {
    "version": {"const": 1},
    "owner": {"type": "string", "minLength": 1},
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "detector_id",
          "after_image_sha256",
          "owner",
          "rationale",
          "expires"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "detector_id": {
            "enum": ["private-key", "aws-secret-access-key", "github-token"]
          },
          "after_image_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "owner": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 20},
          "expires": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
