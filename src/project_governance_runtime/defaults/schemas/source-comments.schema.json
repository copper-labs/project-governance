{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-template.invalid/schemas/source-comments.schema.json",
  "title": "Source Comment Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "contract",
    "mode",
    "unsupported_languages",
    "require_overview_labels",
    "require_type_context_paragraph",
    "minimum_overview_words",
    "active_adapters",
    "source_roots",
    "test_scope",
    "test_globs",
    "boundary_globs",
    "ignore_paths"
  ],
  "properties": {
    "version": {"const": 1},
    "owner": {"type": "string", "minLength": 1},
    "contract": {"type": "string", "minLength": 1},
    "mode": {"enum": ["report-existing-enforce-touched", "enforce-all"]},
    "unsupported_languages": {"enum": ["advisory", "planned"]},
    "require_overview_labels": {"type": "boolean"},
    "require_type_context_paragraph": {"type": "boolean"},
    "minimum_overview_words": {"type": "integer", "minimum": 1},
    "active_adapters": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    },
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
    },
    "test_scope": {"enum": ["excluded", "advisory", "enforced"]},
    "test_globs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "boundary_globs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ignore_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
